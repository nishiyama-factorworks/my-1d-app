# =============================================================================
# .claude/harness.env — ハーネスの「技術スタック依存」を集約する設定ファイル
# =============================================================================
# hooks / scripts/verify.sh / スラッシュコマンドは、コマンド名や閾値をこのファイルからだけ読む。
# 技術スタックを変えるとき（npm へ変更、Jest/Biome の採用など）は、原則ここだけを直す。
#
# 書式: bash の `source` で読み込まれる。KEY="value"（= の前後に空白を入れない）。
# 注意: .claude/settings.json の permissions は pnpm 前提の許可ルールを含む。
#       PKG_MANAGER を変える場合は settings.json 側も合わせて直すこと（MANUAL 5章参照）。
# =============================================================================

# --- パッケージマネージャ ----------------------------------------------------
PKG_MANAGER="pnpm"                      # pnpm | npm | yarn | bun
INSTALL_CMD="pnpm install --frozen-lockfile"

# --- プロジェクト全体の品質ゲートで実行するコマンド ---------------------------
# package.json の scripts と対応させる（MANUAL 2.3 参照）。
TYPECHECK_CMD="pnpm typecheck"          # 例: "typecheck": "tsc --noEmit"
LINT_CMD="pnpm lint"                    # 例: "lint": "eslint ."  または "next lint"
TEST_CMD="pnpm test"                    # 必ず非watchで終了させる 例: "test": "vitest run"
BUILD_CMD="pnpm build"                  # 例: "build": "next build"
E2E_CMD="pnpm test:e2e"                 # 例: "test:e2e": "playwright test"

# --- 編集直後に「1ファイルだけ」に適用するコマンド（末尾にファイルパスが付く）--
# 注意: 単一のコマンドとして実行される。`;` `&&` `|` などのシェル演算子は使えない（必要ならラッパースクリプトを作る）。
FORMAT_FILE_CMD="pnpm exec prettier --write"
LINT_FILE_CMD="pnpm exec eslint"

# --- 編集後フック(post-edit.sh)の対象ファイル（拡張子の正規表現）-------------
FORMAT_TARGET_REGEX='\.(ts|tsx|js|jsx|mjs|cjs|json|css|md|mdx)$'
LINT_TARGET_REGEX='\.(ts|tsx|js|jsx|mjs|cjs)$'

# --- Stop ゲート（Claude が「完了」と言う前に自動検証する仕組み）--------------
STOP_GATE="on"                          # on | off
STOP_GATE_STEPS="typecheck lint test"   # 実行する順序。使える値: typecheck lint test build
STOP_GATE_MAX_BLOCKS=3                  # 連続で差し戻す最大回数（無限ループ防止）。超えると警告だけ出して終了を許可
GATE_BASE_REF="origin/main"             # 変更ファイルの比較基準（ブランチ全体を対象にする）。origin/main が無い間（リポジトリ作成前）は自動で HEAD になる。ローカルだけで使うなら "HEAD"

# 「コードを変えたのにテストが変わっていない」ことの検出（TDD の強制）
REQUIRE_TESTS_WITH_SRC="block"          # off | warn | block
CODE_REGEX='\.(ts|tsx|js|jsx|mjs|cjs|css)$|^package\.json$'   # ゲートを動かす対象（これらが変わったときだけ検証）
SRC_REGEX='^(src|app|features|lib|components|pages)/.*\.(ts|tsx)$'     # 「テストが必要なソース」
SRC_EXCLUDE_REGEX='\.d\.ts$|\.stories\.|(^|/)(layout|loading|error|not-found|template|globals)\.(tsx|css)$'  # テスト不要とみなすもの
TEST_REGEX='\.(test|spec)\.(ts|tsx|js|jsx)$|(^|/)__tests__/|^(tests|e2e)/'                                    # テストファイル

# --- GitHub 連携（session-start.sh）------------------------------------------
# ブランチ名（feat/12-xxx など）から Issue 番号を拾い、番号・タイトル・状態・ラベルだけをセッション開始時に注入する。
# 本文は注入しない（他者が書いた入力のため）。gh 未導入・未認証・リモート無しなら自動でスキップされる。
GITHUB_CONTEXT="on"                     # on | off

# --- 保護ファイル（guard-files.sh）-------------------------------------------
# CLAUDE.md / .claude/ / .github/workflows/ / scripts/verify.sh の編集時に確認を求めるか。
GUARD_HARNESS_FILES="ask"               # ask（確認する）| allow（確認しない）
